<?php

/**
 * @file
 * Installation file for the auth0 module.
 */

/**
 * Implements hook_schema().
 */
function auth0_schema() {
  $schema['auth0_user'] = array(
    'description' => 'Joins auth0 users with drupal users.',
    'fields' => array(
      'auth0_id' => array(
        'description' => 'The user id on auth0',
        'type' => 'varchar',
        'length' => 100,
        'not null' => TRUE,
      ),
      'drupal_id' => array(
        'description' => 'The user id on drupal',
        'type' => 'int',
        'not null' => TRUE,
      ),
      'auth0_object' => array(
        'description' => 'A serialized version of the auth0 user',
        'type' => 'text',
        'not null' => TRUE,
      ),
    ),
    'indexes' => array(
      'drupal_id' => array('drupal_id'),
    ),
    'primary key' => array('auth0_id'),
  );

  return $schema;
}

/**
 * Implements hook_uninstall().
 */
function auth0_uninstall() {
  variable_del('auth0_login_css');
  variable_del('auth0_widget_cdn');
  variable_del('auth0_form_title');
  variable_del('auth0_requires_verified_email');
  variable_del('auth0_allow_signup');
  variable_del('auth0_domain');
  variable_del('auth0_client_id');
  variable_del('auth0_client_secret');
  variable_del('auth0_cookie_secret');
}

/**
 * Generate the auth0_cookie_secret required by auth0-php SDK v8.
 */
function auth0_update_7201() {
  // SdkConfiguration::validateStateWebApp() throws without a cookie secret, so
  // every SDK call site fails until this variable exists. Generating it here
  // rather than leaving it to an administrator closes the window between the
  // deployment and someone visiting the settings form, during which no user
  // could log in. Sites that pin the value in settings.php are left alone.
  $existing = variable_get('auth0_cookie_secret', '');

  if (!empty($existing)) {
    return t('auth0_cookie_secret is already set; left unchanged.');
  }

  // The SDK warns below 32 bytes; drupal_random_bytes() is the D7 CSPRNG.
  variable_set('auth0_cookie_secret', drupal_hash_base64(drupal_random_bytes(32)));

  return t('Generated a random auth0_cookie_secret.');
}

