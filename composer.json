{
    "name": "australian_greens/auth0_drupal",
    "type": "drupal-module",
    "require": {
        "auth0/auth0-php": "^8.0",
        "composer/installers": "~1.0",
        "symfony/http-client": "^5.4",
        "nyholm/psr7": "^1.8"
    },
    "authors": [
        {
            "name": "Auth0"
        }
    ],
    "extra": {
        "installer-name": "auth0"
    },
    "config": {
      "platform": {
         "php": "7.4"
      },
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
